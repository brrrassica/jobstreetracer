# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# One or more chat ids, comma-separated (TELEGRAM_CHAT_IDS is also accepted).
TELEGRAM_CHAT_ID=
# Optional: forum topic id if posting into a Telegram group topic.
TELEGRAM_TOPIC_ID=

# Optional overrides
# JOBSTREETRACER_CONFIG=config.toml
# JOBSTREETRACER_DB=data/jobs.db
# JOBSTREETRACER_OUTPUT_DIR=data
# JOBSTREETRACER_SCHEDULE=*/15 * * * *
# JOBSTREETRACER_TIMEZONE=Asia/Jakarta
# JOBSTREETRACER_DELAY=1.0
