{
  "name": "JobStreetracer",
  "short_name": "JSR",
  "description": "Private job-search radar for JobStreet Indonesia: saved searches, filterable listings, tracking, and Telegram alerts.",
  "id": "/jobstreetracer/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0f22",
  "theme_color": "#0a0f22",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Listings",
      "short_name": "Listings",
      "url": "./#/listings",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New search",
      "short_name": "New search",
      "url": "./#/searches",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
